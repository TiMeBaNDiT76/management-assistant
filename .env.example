# Copy to `.env` for local development. NEVER commit real values.

# --- General ---
NODE_ENV=development
LOG_LEVEL=info

# --- API server ---
HOST=0.0.0.0
PORT=4000
# Directory of the exported web app (Expo static export) served by the API at
# `/` (single origin incl. SPA fallback). Leave unset for API-only mode.
# WEB_DIST_PATH=./apps/api/web-dist
# Comma-separated list of allowed CORS origins (Expo web dev server etc.)
ALLOWED_ORIGINS=http://localhost:8081,http://localhost:19006

# --- Database ---
# SQLite file for local development ( Litestream is only used in Cloud Run).
DB_PATH=./data/dev.db

# --- Authentication (Firebase Auth) ---
# Firebase project used to verify incoming JWTs (issuer/audience).
FIREBASE_PROJECT_ID=your-firebase-project-id
# DANGER: bypasses JWT verification for local tests. Enforced to be ignored
# when NODE_ENV=production.
DEV_BYPASS_AUTH=true

# --- AI (Vertex AI / Gemini via @google/genai) ---
# Either use the Gemini Developer API with an API key ...
GEMINI_API_KEY=
# ... or Vertex AI with Application Default Credentials (service account).
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-central1

# --- Mobile web (Expo) ---
# tRPC endpoint of the API, consumed by the Expo app.
EXPO_PUBLIC_API_URL=http://localhost:4000/trpc

# --- Firebase Auth (Expo app, see docs/firebase-setup.md) ---
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
# Mock login (dev-local-user) without a Firebase project — local development only.
EXPO_PUBLIC_DEV_AUTH_BYPASS=

# --- Litestream (used inside the Cloud Run container only) ---
LITESTREAM_CONFIG=/etc/litestream.yml
LITESTREAM_BUCKET=your-project-id-db-test
LITESTREAM_ENDPOINT=https://storage.googleapis.com

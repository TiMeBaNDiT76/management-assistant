{
  "name": "management-assistant",
  "version": "0.1.0",
  "private": true,
  "description": "AI-assisted leadership & people management companion (monorepo)",
  "packageManager": "pnpm@10.34.9",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "clean": "rm -rf node_modules apps/api/node_modules apps/mobile-web/node_modules packages/shared/node_modules apps/api/dist apps/api/out packages/shared/dist apps/mobile-web/.expo apps/mobile-web/dist .turbo apps/api/.turbo apps/mobile-web/.turbo packages/shared/.turbo data/*.db data/*.db-shm data/*.db-wal"
  },
  "devDependencies": {
    "@eslint/js": "^9.30.0",
    "eslint": "^9.30.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "turbo": "^2.11.13",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.40.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "better-sqlite3",
      "esbuild",
      "sqlite-vec"
    ]
  }
}

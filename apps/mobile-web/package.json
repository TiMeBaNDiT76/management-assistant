{
  "name": "@mgmt/mobile-web",
  "version": "0.1.0",
  "private": true,
  "description": "Universal Expo app (web/iOS/Android) for the management-assistant",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build": "expo export --platform web",
    "typecheck": "tsc -p . --noEmit",
    "lint": "eslint .",
    "test": "jest",
    "test:watch": "jest --watch",
    "clean": "rm -rf .expo dist .turbo web-build"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "@expo/vector-icons": "^15.1.1",
    "@mgmt/api": "workspace:*",
    "@mgmt/shared": "workspace:*",
    "@tanstack/react-query": "^5.108.4",
    "@trpc/client": "^11.31.1",
    "@trpc/server": "^11.31.1",
    "@trpc/tanstack-react-query": "^11.31.1",
    "expo": "~58.0.26",
    "expo-constants": "~58.0.16",
    "expo-linking": "~58.0.17",
    "expo-router": "~58.0.32",
    "expo-status-bar": "~58.0.5",
    "nativewind": "^4.2.7",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.88.1",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "jest": "^30.0.0",
    "jest-expo": "~58.0.15",
    "react-server-dom-webpack": "~19.3.0",
    "tailwindcss": "^3.4.17",
    "test-renderer": "^1.3.1",
    "typescript": "~6.0.3"
  }
}
